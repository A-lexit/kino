########################################
# Application
########################################
APP_NAME=Kino
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
# Якщо запускаєте без Docker:
# DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kino
DB_USERNAME=root
DB_PASSWORD=root

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# API Keys
TMDB_API_KEY=
OMDB_API_KEY=

# Seeder admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Для локальної розробки
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

# Cache
# Для локальної розробки
CACHE_STORE=array

# Для Redis
# CACHE_STORE=redis


# Redis (Docker)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null

MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"


# Email для тестового маршруту /send
MAIL_TEST_RECIPIENT=test@example.com

VITE_APP_NAME="${APP_NAME}"
